{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "outDir": "./tmp/vite-config",
    "tsBuildInfoFile": "./tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
