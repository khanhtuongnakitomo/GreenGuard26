# Must match app/backend (port 4000) and seeded machine credentials
BACKEND_URL=http://localhost:4000/api
MACHINE_CODE=0001
MACHINE_API_KEY=machine-demo-key

# Must match QR_SECRET in GreenPoint-Backend/.env (min 16 chars)
QR_SECRET=your_qr_secret_here

# Reinforcement / live learning for Model 2 (PET cap-label)
# Set REINFORCEMENT_LEARNING=on to save crops when PET is accepted or rejected.
# Set RL_AUTO_TRAIN=on to fine-tune Model 2 in a background process after RL_MIN_SAMPLES new items.
REINFORCEMENT_LEARNING=off
RL_AUTO_TRAIN=off
RL_SAVE_ACCEPTS=on
RL_MIN_SAMPLES=5
RL_EPOCHS=3
RL_DEVICE=0

