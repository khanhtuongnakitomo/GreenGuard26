{
  "manifest": "models/m1_candidate_manifest.json",
  "candidate_validation": {
    "status": "NOT_READY"
  },
  "m1": {
    "min_area_frac": 0.02,
    "detector": {
      "path": "models/candidates/m1_efficient_current.onnx",
      "task": "detect",
      "classes": ["metal_can", "pet_bottle"],
      "visible_class_ids": [0, 1],
      "infer_conf": 0.05,
      "decision_conf": 0.65,
      "decision_conf_by_class": {
        "metal_can": 0.65,
        "pet_bottle": 0.65
      },
      "candidate_only": true
    },
    "box_smooth": 0.35,
    "miss_hold": 3
  },
  "runtime": {
    "device": "cpu",
    "target_fps": 5.0,
    "decision_window": 7,
    "decision_quorum": 4,
    "clear_frames": 8,
    "result_hold_s": 1.5
  },
  "ui": {
    "display_scale": 1.5,
    "window_title": "GreenGuard Model 1 Candidate"
  }
}
